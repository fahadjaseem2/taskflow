# Used by docker-compose.yml (and docker-compose.monitoring.yml) for variable
# substitution. Docker Compose loads a file named exactly ".env" in this
# directory automatically - copy this file to ".env" and adjust as needed:
#
#   cp .env.example .env
#
# .env is gitignored - never commit real secrets in it.

# ---- Database ----
DB_USER=taskflow
DB_PASSWORD=taskflow_dev_password
DB_NAME=taskflow
DB_PORT=5432

# ---- Redis ----
REDIS_PORT=6379

# ---- Backend ----
BACKEND_PORT=4000
NODE_ENV=production

# Generate a real one for anything beyond local dev, e.g.:
#   openssl rand -hex 32
JWT_SECRET=dev-only-secret-change-me
JWT_EXPIRES_IN=7d

# Used to build links in verification emails (must match wherever the
# frontend is actually reachable from the browser clicking the link).
APP_URL=http://localhost:3000

CACHE_TTL_SECONDS=30
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Optional - leave all blank to use the automatic Ethereal dev-preview
# fallback (see backend/src/services/email.service.ts). Set these to send
# through real SMTP instead (Gmail app password, SendGrid, Mailgun, SES, etc.).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=TaskFlow <no-reply@taskflow.local>

# ---- Frontend ----
FRONTEND_PORT=3000
# Baked into the frontend build at image build time (Vite env vars are
# compile-time, not runtime) - this must be reachable from the browser,
# not from inside the Docker network, so "backend" (the service name)
# won't work here the way it does for server-to-server calls above.
VITE_API_URL=http://localhost:4000

# ---- Monitoring (docker-compose.monitoring.yml only) ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
