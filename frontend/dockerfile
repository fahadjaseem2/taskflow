# =========================
# Stage 1: Build frontend
# =========================

# Node is required to install dependencies and build the React/Vite application.
# node:22-slim = Node.js 22 on a smaller Debian-based image.
FROM node:22-slim AS builder

# All following commands in this stage will work inside /app.
WORKDIR /app

# Copy package.json and package-lock.json first.
# This allows Docker to cache the npm install layer.
COPY package*.json ./

# Install the exact dependencies from package-lock.json.
RUN npm ci

# Copy the rest of the frontend source code and configuration files.
# This includes src/, index.html, vite.config.ts, tsconfig files, etc.
COPY . .

# Build the React/Vite application.
# The production files will normally be created inside /app/dist.
RUN npm run build


# =========================
# Stage 2: Production server
# =========================

# We no longer need Node to run the frontend.
# Nginx will serve the static files from the dist/ directory.
FROM nginx:alpine

# Copy the production build created in Stage 1
# into the directory Nginx uses to serve websites.
COPY --from=builder /app/dist /usr/share/nginx/html

# Replace Nginx's default configuration with your own configuration.
COPY nginx.conf /etc/nginx/conf.d/default.conf


# Prepare Nginx to run as a non-root user.
#
# /usr/share/nginx/html
# → contains your frontend files.
#
# /var/cache/nginx
# → Nginx may need to write temporary/cache files here.
#
# chown nginx:nginx
# → makes the nginx user/group the owner.
#
# -R
# → recursively applies ownership to everything inside.
RUN chown -R nginx:nginx /usr/share/nginx/html /var/cache/nginx && \
    
    # Create the PID file while we still have root privileges.
    # 'touch' creates the file if it doesn't exist.
    touch /var/run/nginx.pid && \
    
    # Give the nginx user ownership of the PID file.
    chown nginx:nginx /var/run/nginx.pid


# IMPORTANT:
# USER does NOT create a user.
# The nginx:alpine image already has an 'nginx' user.
#
# This tells Docker:
# "From here, run the application as nginx instead of root."
USER nginx


# Documentation that the container expects to use port 8080.
#
# Your nginx.conf MUST have something like:
#     listen 8080;
#
# because you're running Nginx as a non-root user.
EXPOSE 8080


# Keep Nginx running in the foreground.
#
# "daemon off;" prevents Nginx from going into the background.
# Docker needs the main process to stay running.
CMD ["nginx", "-g", "daemon off;"]