NODE_ENV=development
PORT=4000

DB_HOST=postgres
DB_PORT=5432
DB_USER=taskflow
DB_PASSWORD=taskflow_dev_password
DB_NAME=taskflow

REDIS_HOST=redis
REDIS_PORT=6379

CACHE_TTL_SECONDS=30
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d

APP_URL=http://localhost:3000

# Optional - if unset, verification/notification emails are logged to the
# console instead of sent (fine for local dev). Set these to use real SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=TaskFlow <no-reply@taskflow.local>
